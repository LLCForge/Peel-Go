{
  "name": "peel-go",
  "version": "0.1.0",
  "description": "Open-source Go deobfuscator that runs in your browser. Your binaries never leave your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peel-go": "bin/peel-go.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLCForge/Peel-Go.git"
  },
  "homepage": "https://github.com/LLCForge/Peel-Go#readme",
  "keywords": [
    "deobfuscator",
    "go",
    "golang",
    "garble",
    "pclntab",
    "elf",
    "pe",
    "mach-o",
    "malware-analysis",
    "reverse-engineering",
    "security"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fixtures": "node scripts/make-fixtures.js",
    "bench": "node scripts/bench.js",
    "test": "node test/run.js && node test/all.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  }
}
